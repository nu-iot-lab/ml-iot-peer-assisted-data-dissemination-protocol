# LoRa 2.4 GHz raw/profile-based config
--radio-profile lora24
--testbed testbeds/testbed_2km_200_1.csv
--out-dir output/lora24_sf9_direct

# LoRa2.4 settings
--sf-adv 9
--sf-data 9
--bw-hz 812500
--cr-denom 5

# Deployment/model settings
--area-m2 4000000
--model-size-bytes 250000
--miss-encoding bitmap

# Auto ADV/UPD/MISS windows
--auto-data-repair-windows
--auto-control-windows
--reply-collision-rho 0.1
--data-repair-window-margin 1.05
--data-backoff-ms 0 1000

# Channel assignment: ADV on 0, UPD on 1, DATA/MISS/REPAIR on data channels.
--chan-adv 0
--chan-upd 1
--chan-data 1

--until-complete
--max-days 50
