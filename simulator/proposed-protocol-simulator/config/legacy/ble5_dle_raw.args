# BLE 5 DLE raw PHY-like config
--radio-profile ble5_dle_raw
--testbed testbeds/testbed_2km_300_3.csv
--out-dir output/ble5_dle_raw_direct

# Raw bitrate profiles ignore LoRa SF/BW for airtime, but the fields are still kept for metadata/window formulas.
--sf-adv 9
--sf-data 9
--bw-hz 125000
--cr-denom 5

--area-m2 4000000
--model-size-bytes 250000
--miss-encoding bitmap

--auto-data-repair-windows
--auto-control-windows
--reply-collision-rho 0.1
--data-repair-window-margin 1.05
--data-backoff-ms 0 1000

--chan-adv 0
--chan-upd 1
--chan-data 1

--until-complete
--max-days 50
