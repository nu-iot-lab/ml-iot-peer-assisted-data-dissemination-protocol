# Wi-Fi HaLow raw PHY-like config
--radio-profile halow_raw
--testbed testbeds/testbed_2km_200_1.csv
--out-dir output_deluge/halow_raw_direct

--sf-adv 9
--sf-data 9
--bw-hz 1000000
--cr-denom 5

--area-m2 4000000
--model-size-bytes 250000
--miss-encoding bitmap

# Deluge protocol settings
--deluge-page-packets 48
--deluge-req-window-ms 1000
--deluge-req-backoff-ms 0 500
--deluge-data-gap-ms 2
--deluge-round-gap-ms 200
--deluge-sender-selection recent
--deluge-page-selection lowest
--deluge-packet-order sequential
--deluge-immediate-adv-on-page-complete

--auto-data-repair-windows
--auto-control-windows
--reply-collision-rho 0.1
--data-repair-window-margin 1.05
--data-backoff-ms 0 1000

--chan-adv 0
--chan-upd 1
--chan-data 1

--max-days 100

# Fast fading model
--fading rayleigh
--rayleigh-min-db -40
--rayleigh-max-db 20

--dynamic-data-repair
--data-inactivity-airtimes 10
--repair-inactivity-airtimes 10
--owner-miss-extra-airtimes 2
--repair-chunks-per-round 0


# Simplified CSMA/CA-like clear-channel assessment
--csma-ca
--csma-stages ADV REQ DATA
--csma-carrier-sense-thresh-dbm -85
--csma-busy-wait-airtime-factor 0.5
--csma-busy-wait-jitter 0.25
--csma-max-deferrals 0

--duty-cycle-limit-s 36
--duty-cycle-data-fraction 0.5
--duty-cycle-include-adv-in-data

--pl-sigma 3.57
--collision-thresh-db 1
--tx-dbm 18
--pl-ref-m 100
--pl-ref-loss-db 92.5
--pl-gamma 3.76
--num-channels 5
--raw-bitrate-bps 150000
--raw-max-payload-bytes 2304
--raw-sensitivity-dbm -105
--halow-preamble-header-us 560
--halow-symbol-us 40
--halow-ndbps 6
--halow-service-tail-bits 22
--data-header-bytes 9
--data-pl-bytes 2288
--control-window-node-factor 0.5
--control-window-node-offset -1
