# Sub-GHz FSK raw PHY-like config
--radio-profile subghz_fsk_raw
--testbed testbeds/testbed_2km_100_1.csv
--out-dir output_deluge/subghz_fsk_raw_direct

--sf-adv 9
--sf-data 9
--bw-hz 100000
--cr-denom 5

--area-m2 4000000
--model-size-bytes 150000
--miss-encoding bitmap

# Deluge protocol settings
--deluge-page-packets 48
--deluge-req-window-ms 1000
--deluge-req-backoff-ms 0 500
--deluge-data-gap-ms 2
--deluge-round-gap-ms 200
--deluge-sender-selection recent
--deluge-page-selection lowest
--deluge-packet-order sequential
--deluge-immediate-adv-on-page-complete

--auto-data-repair-windows
--auto-control-windows
--reply-collision-rho 0.1
--data-repair-window-margin 1.05
--data-backoff-ms 0 1000

--chan-adv 0
--chan-upd 1
--chan-data 1

--max-days 100

# Fast fading model
--fading rayleigh
--rayleigh-min-db -40
--rayleigh-max-db 20

--dynamic-data-repair
--data-inactivity-airtimes 10
--repair-inactivity-airtimes 10
--owner-miss-extra-airtimes 2
--repair-chunks-per-round 0

--duty-cycle-limit-s 36
--duty-cycle-data-fraction 0.5
--duty-cycle-include-adv-in-data

--pl-sigma 3.57
--collision-thresh-db 7
--tx-dbm 14
--pl-ref-m 100
--pl-ref-loss-db 101.51
--pl-gamma 3.0
--num-channels 16
--raw-bitrate-bps 50000
--raw-max-payload-bytes 255
--raw-sensitivity-dbm -109
--fsk-preamble-bytes 4
--fsk-sfd-bytes 2
--fsk-phr-bytes 2
--data-header-bytes 10
--data-pl-bytes 245
--control-window-node-factor 1
--control-window-node-offset 0
